{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calling-ai",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-05-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "calling-ai-recordings" }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTETAKER_QUEUE", "queue": "notetaker-jobs" }
    ],
    "consumers": [
      { "queue": "notetaker-jobs", "max_batch_size": 1, "max_retries": 5 }
    ]
  },
  "kv_namespaces": [
    { "binding": "TTS_CACHE", "id": "cbc4a20ca23a46c6b2b78d4bf3775225" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calling-ai-db",
      "database_id": "e461e69e-16d5-470d-b3df-54fee411b4ed"
    }
  ],
  "containers": [
    {
      "class_name": "RecorderContainer",
      "image": "./services/meeting-recorder/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CALL_SESSION", "class_name": "CallSession" },
      { "name": "MEMORY", "class_name": "MemoryStore" },
      { "name": "LOGS", "class_name": "LogHub" },
      { "name": "RECORDER", "class_name": "RecorderContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallSession"] },
    { "tag": "v2", "new_sqlite_classes": ["MemoryStore"] },
    { "tag": "v3", "new_sqlite_classes": ["LogHub"] },
    { "tag": "v4", "new_sqlite_classes": ["RecorderContainer"] }
  ]
}
